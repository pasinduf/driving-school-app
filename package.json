{
  "name": "driving-school-frontend",
  "private": true,
  "version": "0.0.0",
  "packageManager": "npm@11.12.1",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "preview": "turbo run preview",
    "dev:website": "turbo run dev --filter=website",
    "dev:booking-admin": "turbo run dev --filter=booking-admin",
    "build:website": "turbo run build --filter=website",
    "build:booking-admin": "turbo run build --filter=booking-admin"
  },
  "devDependencies": {
    "turbo": "^2.3.3"
  }
}
